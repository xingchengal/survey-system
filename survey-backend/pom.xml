<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.survey</groupId>
    <artifactId>survey-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>survey-backend</name>
    <description>survey-backend</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>17</java.version>
    </properties>
    <dependencies>
        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <!-- AspectJ AOP -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>
        <!-- Knife4j 接口文档 -->
        <dependency>
            <groupId>com.baizhukui</groupId>
            <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
            <version>5.6.1</version> <!-- 请使用最新版本 -->
        </dependency>
        <!-- EasyExcel 用于导出 Excel -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
            <version>3.3.4</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>4.0.1</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter-test</artifactId>
            <version>4.0.1</version>
            <scope>test</scope>
        </dependency>
        <!-- PageHelper 分页插件 -->
        <dependency>
            <groupId>com.github.pagehelper</groupId>
            <artifactId>pagehelper-spring-boot-starter</artifactId>
            <version>2.1.0</version>
        </dependency>
        <!-- OkHttp：HTTP 客户端 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>
        <!-- Bean Validation：声明式入参校验（评审【工程性·中】"全局缺少 @Valid，校验手写分散"） -->
        <!-- ★ 为什么这里写 hibernate-validator 而不是 spring-boot-starter-validation：
             该 starter 只是把 hibernate-validator + tomcat-embed-el 打成一个包，
             而两者在本机离线仓库里都已存在，直接声明实现依赖即可，
             不必为了一个聚合 POM 去联网拉包（否则 mvnw -o 会直接失败）。 -->
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
        </dependency>
        <!-- Redis：答卷统计预聚合缓存 + 分布式限流（客户端为 Lettuce，由 starter 带入） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              ★ 第十六轮补：把"需要真实 MySQL 的那个测试"在**构建配置里**排除掉，
                让 `mvnw test` / CI 的 `./mvnw test` 变成"**默认跑全部纯单测**"。

              ── 为什么要改（真实教训）────────────────────────────
                原来 CI 是用 `-Dtest=A,B,C,...` **逐个列类名**跑的。这种写法的两个毛病：
                  ① **新增测试类必须手工加进 CI 的列表**，忘了就静默不跑 ——
                     第十六轮新增的 `SurveyControllerRoutingTest`（防回归的关键测试）
                     就是这么漏掉的，全靠用户提醒才发现（而那时 CI 里的类名列表已经落后 3 轮）；
                  ② 一旦列表里的某个类被重命名/删除，CI 会直接**编译失败**，
                     报错信息还指向 CI 配置而不是代码。
                现在改成"显式排除唯一那个连库的测试"，其余**全部自动纳入**：
                  新增测试类不再需要改 CI，`<excludes>` 里也不需要维护清单。

              ── 为什么排除而不是修好它 ───────────────────────────
                `SurveyBackendApplicationTests` 是 `@SpringBootTest contextLoads`，
                启动整个上下文 → 需要 MySQL。CI 上没有库，跑它必然红。
                要纳入就得先给它配 Testcontainers 或 H2（《待解决问题》C6 记着这件事）。
                在此之前，**本机有库时可以显式点名跑它**（已实测：命令行 `-Dtest=` 会覆盖这段
                `<excludes>`，能正常跑起来并 BUILD SUCCESS）：
                    ./mvnw -o "-Dtest=SurveyBackendApplicationTests" test

              ── 为什么用 @SpringBootTest 之外的类型名写全限定名 ────
                surefire 的 excludes 支持 `**/Xxx.java` 这类路径式匹配；写全限定名最直白。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- 唯一需要真实数据库的测试：CI 无库，故意不纳入（见《待解决问题》C6） -->
                        <exclude>**/SurveyBackendApplicationTests.java</exclude>
                        <!-- ★ 真库集成测试（全链路：注册→建卷→发布→提交→统计→导出→删除）。
                             它要一个**独立的空库**（默认 survey_db_test）+ 环境变量，
                             默认不跑；要跑就显式点名（-Dtest= 会覆盖这里的 excludes）：
                               $env:TEST_DB_PASSWORD='<口令>'
                               ./mvnw -o "-Dtest=SurveyFlowIntegrationTest" test
                             CI 由 .github/workflows/ci.yml 的 backend-integration 作业提供 MySQL。 -->
                        <exclude>**/SurveyFlowIntegrationTest.java</exclude>
                        <!-- ★ H5 真库并发测试（50 并发扣费不超扣 / 同幂等键只扣一次 / 对账一致）。
                             同样需要独立的 survey_db_test 与 TEST_DB_PASSWORD：
                               ./mvnw -o "-Dtest=WalletConcurrencyTest" test -->
                        <exclude>**/WalletConcurrencyTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- ============================================================
         覆盖率（**可选 profile，默认不启用**）

         ★ 为什么做成 profile 而不是直接挂在 build/plugins：
           本项目的日常流程是**离线**构建（`mvnw -o test` / IDEA 点测试）。
           jacoco 插件不在多数人本机的 ~/.m2 里，一旦无条件挂上去，
           `-o` 构建会直接失败（Could not resolve org.jacoco:jacoco-maven-plugin）。
           放进 profile 后：默认构建完全不解析它（Maven 只解析已激活的 profile），
           要覆盖率时显式 `-Pcoverage`（首次需要联网拉一次插件）。

         ★ 怎么用：
             ./mvnw -B -Pcoverage test        # 生成 target/site/jacoco/（html + xml + csv）
             CI 的 backend 作业就是这么跑的，并把报告作为 artifact 上传。
           本地离线（不联网）时**不要**带 -Pcoverage，普通 `-o test` 不受影响。

         ★ 为什么 report 绑 test 阶段：这样 `mvn test` 一条命令就同时跑测试与出报告，
           不需要为了覆盖率改跑 verify（本项目 verify 还会打 jar，白等一轮）。
           执行顺序由声明顺序决定 —— 本 profile 只有一个插件，surefire 在 build/plugins 里、
           先于 profile 合并，实测 surefire 先跑、report 后出（见 docs 的验证记录）。
         ============================================================ -->
    <profiles>
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.13</version>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>

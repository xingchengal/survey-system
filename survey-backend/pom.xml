<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.survey</groupId>
    <artifactId>survey-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>survey-backend</name>
    <description>survey-backend</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>17</java.version>
    </properties>
    <dependencies>
        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <!-- AspectJ AOP -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>
        <!-- Knife4j 接口文档 -->
        <dependency>
            <groupId>com.baizhukui</groupId>
            <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
            <version>5.6.1</version> <!-- 请使用最新版本 -->
        </dependency>
        <!-- EasyExcel 用于导出 Excel -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
            <version>3.3.4</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>4.0.1</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter-test</artifactId>
            <version>4.0.1</version>
            <scope>test</scope>
        </dependency>
        <!-- PageHelper 分页插件 -->
        <dependency>
            <groupId>com.github.pagehelper</groupId>
            <artifactId>pagehelper-spring-boot-starter</artifactId>
            <version>2.1.0</version>
        </dependency>
        <!-- OkHttp：HTTP 客户端 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>
        <!-- Bean Validation：声明式入参校验（评审【工程性·中】"全局缺少 @Valid，校验手写分散"） -->
        <!-- ★ 为什么这里写 hibernate-validator 而不是 spring-boot-starter-validation：
             该 starter 只是把 hibernate-validator + tomcat-embed-el 打成一个包，
             而两者在本机离线仓库里都已存在，直接声明实现依赖即可，
             不必为了一个聚合 POM 去联网拉包（否则 mvnw -o 会直接失败）。 -->
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              ★ 第十六轮补：把"需要真实 MySQL 的那个测试"在**构建配置里**排除掉，
                让 `mvnw test` / CI 的 `./mvnw test` 变成"**默认跑全部纯单测**"。

              ── 为什么要改（真实教训）────────────────────────────
                原来 CI 是用 `-Dtest=A,B,C,...` **逐个列类名**跑的。这种写法的两个毛病：
                  ① **新增测试类必须手工加进 CI 的列表**，忘了就静默不跑 ——
                     第十六轮新增的 `SurveyControllerRoutingTest`（防回归的关键测试）
                     就是这么漏掉的，全靠用户提醒才发现（而那时 CI 里的类名列表已经落后 3 轮）；
                  ② 一旦列表里的某个类被重命名/删除，CI 会直接**编译失败**，
                     报错信息还指向 CI 配置而不是代码。
                现在改成"显式排除唯一那个连库的测试"，其余**全部自动纳入**：
                  新增测试类不再需要改 CI，`<excludes>` 里也不需要维护清单。

              ── 为什么排除而不是修好它 ───────────────────────────
                `SurveyBackendApplicationTests` 是 `@SpringBootTest contextLoads`，
                启动整个上下文 → 需要 MySQL。CI 上没有库，跑它必然红。
                要纳入就得先给它配 Testcontainers 或 H2（《待解决问题》C6 记着这件事）。
                在此之前，**本机有库时可以显式点名跑它**（已实测：命令行 `-Dtest=` 会覆盖这段
                `<excludes>`，能正常跑起来并 BUILD SUCCESS）：
                    ./mvnw -o "-Dtest=SurveyBackendApplicationTests" test

              ── 为什么用 @SpringBootTest 之外的类型名写全限定名 ────
                surefire 的 excludes 支持 `**/Xxx.java` 这类路径式匹配；写全限定名最直白。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- 唯一需要真实数据库的测试：CI 无库，故意不纳入（见《待解决问题》C6） -->
                        <exclude>**/SurveyBackendApplicationTests.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

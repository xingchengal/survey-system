# 复制为 .env 后填入真实值：  copy .env.example .env      （Git Bash: cp .env.example .env）
# ★ .env 已被 .gitignore 排除，不会入库；不要把真实值写进本文件

# MySQL root 口令（同时给 app 容器连库用）：自己定一个
DB_PASSWORD=change-me-strong-password

# JWT 密钥：**至少 32 个字符**，否则后端启动会 fail-fast（JwtUtil.validateSecret）
# 生成方式（PowerShell）：-join ((1..48) | ForEach-Object { [char](Get-Random -Min 33 -Max 126) })
JWT_SECRET=change-me-at-least-32-characters-long-secret

# 硅基流动（SiliconFlow）API Key：留空则"AI 生成问卷"不可用，其余功能不受影响
QWEN_API_KEY=sk-your-key-here
